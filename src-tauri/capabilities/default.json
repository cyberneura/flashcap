{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only. App commands are listed one by one: only what this page invokes (see tests/capabilities.test.mts)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-read-image",
    "drag:default",
    "dialog:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "allow-config-get-all",
    "allow-config-set",
    "allow-run-shell-command",
    "allow-open-shell-log",
    "allow-open-shell-log-dir",
    "allow-open-preferences",
    "allow-take-screenshot-interactive",
    "allow-take-screenshot-timer",
    "allow-write-image-to-file",
    "allow-load-image-file",
    "allow-open-save-directory",
    "allow-save-pasted-image",
    "allow-ocr-image",
    "allow-ocr-capture-region",
    "allow-show-notification",
    "allow-open-region-selector",
    "allow-stop-video-recording",
    "allow-export-video",
    "allow-check-ffmpeg-available",
    "allow-list-saved-images",
    "allow-saved-image-thumbnail"
  ]
}
